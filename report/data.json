  [
   "courses_status_audit",
   "courses",
   "CREATE TRIGGER courses_status_audit AFTER UPDATE OF status ON edu.courses FOR EACH ROW WHEN (((old.status)::text IS DISTINCT FROM (new.status)::text)) EXECUTE FUNCTION edu.trg_course_audit()"
  ],
  [
   "courses_status_transition",
   "courses",
   "CREATE TRIGGER courses_status_transition BEFORE UPDATE OF status ON edu.courses FOR EACH ROW EXECUTE FUNCTION edu.trg_course_status_transition()"
  ],
  [
   "courses_teacher_check",
   "courses",
   "CREATE TRIGGER courses_teacher_check BEFORE INSERT OR UPDATE OF teacher_id ON edu.courses FOR EACH ROW EXECUTE FUNCTION edu.trg_course_teacher_check()"
  ],
  [
   "enrollments_check",
   "enrollments",
   "CREATE TRIGGER enrollments_check BEFORE INSERT OR UPDATE ON edu.enrollments FOR EACH ROW EXECUTE FUNCTION edu.trg_enrollment_check()"
  ],
  [
   "grades_audit",
